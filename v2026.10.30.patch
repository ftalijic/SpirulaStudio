--- a/Dockerfile
+++ b/Dockerfile
@@ -69,8 +69,8 @@
 # Pinned on purpose (lesson from LichtFeld's floating LFS_REF=master): bump
 # both values together when moving to a new release. Releases:
 # https://github.com/harry7557558/spirula-studio/releases
-ARG SPIRULA_VERSION=2026.9.24
-ARG SPIRULA_SHA256=3560119e1d6ff91fa4bf49ed6a196f8b092db700e252f6288aa57a7568a65143
+ARG SPIRULA_VERSION=2026.10.30
+ARG SPIRULA_SHA256=19e9fdabdfa73d26cabd7e078ea6b12f2f8b976e457d21b83d6a30e4921ad5a2
 
 RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip \
     && rm -rf /var/lib/apt/lists/*
--- a/build-image.yml
+++ b/build-image.yml
@@ -7,7 +7,7 @@
   workflow_dispatch:
     inputs:
       spirula_version:
-        description: "Spirula release (without the v), e.g. 2026.9.24 - leave empty to use the Dockerfile's pinned value"
+        description: "Spirula release (without the v), e.g. 2026.10.30 - leave empty to use the Dockerfile's pinned value"
         required: false
         default: ""
       spirula_sha256:
--- a/README.md
+++ b/README.md
@@ -28,6 +28,7 @@
 cat /root/vulkan-check.log     # GPU name + Vulkan apiVersion; should NOT show ERROR
 spirula sam devices            # must list the GPU as meeting the baseline (Vulkan 1.2 + BDA + timeline semaphores)
 colmap -h | head -3            # "COLMAP 4.x ... with CUDA"
+cat /opt/spirula/VERSION       # pinned Spirula release, e.g. 2026.10.30
 ```
 
 If `spirula sam devices` says "no Vulkan devices were found", the host isn't giving the container the driver's graphics/Vulkan libraries. The image sets `NVIDIA_DRIVER_CAPABILITIES=all` and ships a fallback ICD file, so check `ls /usr/lib/x86_64-linux-gnu/libGLX_nvidia*`. If nothing is there, try a different GPU type or datacenter.
